# ============================================================
# GridNest Backend — Environment Variables
# NEVER commit this file to Git. It holds your secrets.
# ============================================================

# Django secret key — used for hashing sessions, tokens, cookies.
# Replace this with a long random string in production.
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Debug mode — set to False in production to hide error details
DEBUG=True

# Allowed hosts — comma-separated list of domains that can access the API
# Use * for local dev, replace with your real domain in production
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# PostgreSQL Database Settings
# ============================================================
DB_NAME=gridnest_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
