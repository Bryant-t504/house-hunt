# GridNest Production Environment Variables
# Copy this to .env and fill in the secrets

DEBUG=False
SECRET_KEY=generate-a-strong-random-key-here
ALLOWED_HOSTS=your-production-domain.com,backend

# Database
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://postgres:postgres@db:5432/gridnest

# Redis (for WebSockets)
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://your-production-domain.com
CSRF_TRUSTED_ORIGINS=http://your-production-domain.com
